PORT=3000
STAFF_PASSWORD=change-this-password
AUTH_SECRET=change-this-long-random-secret
AUTH_TOKEN_TTL_MS=43200000
UPLOAD_MAX_BYTES=5242880

# Comma-separated origins. Leave empty to block browser cross-origin requests.
# Same-origin requests from files served by this Express app do not need this.
# Example: https://example.com,https://www.example.com
ALLOWED_ORIGINS=
